# ── Keep these (existing) ────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://...
JWT_SECRET=your_jwt_secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
PORT=5000

# ── Telegram (keep — admin alerts still go here too) ─────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Resend (email) — ADD THESE ────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=SatvikMeals <hello@satvikmeals.in>
ADMIN_EMAIL=your_admin_email@gmail.com
# Used in the email header/footer logo image. Must be a public HTTPS URL —
# your live logo.jpg works once deployed (https://satvikmeals.in/logo.jpg).
LOGO_URL=https://satvikmeals.in/logo.jpg

# ── CRITICAL — avoiding the Gmail "Promotions" tab ────────────────────────────
# Email theme/wording changes alone do NOT control which inbox tab a message
# lands in. The single biggest factor is DOMAIN AUTHENTICATION. You must:
#   1. In the Resend dashboard → Domains → add "satvikmeals.in" (not a
#      sub-address like @gmail.com — RESEND_FROM must use YOUR domain).
#   2. Resend will give you 3 DNS records (SPF/TXT, DKIM/TXT, DMARC/TXT).
#      Add these in wherever you manage satvikmeals.in's DNS (GoDaddy,
#      Namecheap, Cloudflare, etc).
#   3. Wait for Resend to show the domain as "Verified" (can take up to 24-48h
#      for DNS to propagate, usually much faster).
# Without a verified domain, even a perfectly-themed transactional email is
# far more likely to be flagged as bulk/promotional mail by Gmail. This is
# also required for RESEND_FROM to work at all in production — Resend
# blocks sending from unverified domains on paid use.

# ── Baileys WhatsApp sender — ADD THIS ────────────────────────────────────────
# The WhatsApp session is now stored in MongoDB (same MONGO_URI above) — it
# survives Render restarts/redeploys automatically. No file path needed.
# Connect/disconnect the WhatsApp number entirely from the Admin Panel →
# WhatsApp tab (scan QR shown in the browser — see instructions below).
#
# Your personal WhatsApp number (10 digits, no +91) — receives admin alerts
ADMIN_WA_NUMBER=9031447621

# ── HOW TO CONNECT WHATSAPP (no terminal/SSH needed) ──────────────────────────
#   1. Deploy this app to Render with MONGO_URI and ADMIN_WA_NUMBER set.
#   2. Log into satvikmeals.in/admin.html as admin.
#   3. Click the "WhatsApp" tab in the left sidebar.
#   4. Click "Connect WhatsApp" — a QR code appears directly in the browser
#      (no server console access required).
#   5. On the phone that will act as the SatvikMeals WhatsApp number:
#      WhatsApp app → Settings (or the 3-dot menu) → Linked Devices →
#      Link a Device → scan the QR code shown on the admin page.
#   6. Once scanned, the status badge turns green ("Connected ✅"). The
#      session is saved in MongoDB — future Render restarts reconnect
#      automatically without scanning again.
#   7. To test: still in the WhatsApp tab, scroll to "Send a Message" →
#      choose "Test Message" → click Send. You should receive it on
#      ADMIN_WA_NUMBER within a few seconds.
#   8. To send to any specific customer (custom / welcome / plan-assigned
#      message), select "Send To" → pick the customer → choose message
#      type → Send. Useful for manually re-sending a welcome message or
#      testing what a customer will receive.
#   9. To disconnect (e.g. to link a different number), click
#      "Disconnect & Remove Session" — you'll need to scan a fresh QR
#      to reconnect.

# ── Google Sign-In troubleshooting (white/blank screen after choosing account) ─
# If Google Sign-In freezes or shows a blank screen after picking an account,
# check BOTH of these (this is almost always a Google Cloud Console config
# issue, not a code issue):
#   1. Go to console.cloud.google.com → APIs & Services → Credentials →
#      your OAuth 2.0 Client ID → "Authorized JavaScript origins".
#      It MUST include your exact live URL, e.g.:
#         https://satvikmeals.in
#         https://www.satvikmeals.in   (if you use the www version too)
#      Missing or mismatched origins here cause exactly this symptom.
#   2. Make sure ALLOWED_ORIGINS above (server-side CORS) also lists the
#      same domain(s). Both must match your real domain.

# ── Security — ADD THIS ────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API (CORS).
# Add your real domain(s) here. Do NOT use "*" in production.
ALLOWED_ORIGINS=https://satvikmeals.in,https://www.satvikmeals.in

# ── HTTPS / SSL ────────────────────────────────────────────────────────────────
# This app does not terminate TLS itself — it expects to run behind a reverse
# proxy or hosting platform that provides HTTPS (Render, Railway, Nginx + Let's
# Encrypt, Cloudflare, etc). No code changes are needed here; just make sure:
#   1. Your domain's DNS points to your host.
#   2. Your hosting platform's "Force HTTPS" / "Auto SSL" setting is ON.
#   3. ALLOWED_ORIGINS above uses https:// (not http://) for your real domain.
# If self-hosting on a VPS, use Certbot (Let's Encrypt) + Nginx as a reverse
# proxy in front of this Node process — do not expose Node directly on port 80/443.

# ── Remove these (Instamojo — no longer needed) ───────────────────────────────
# INSTAMOJO_API_KEY=
# INSTAMOJO_AUTH_TOKEN=
# INSTAMOJO_BASE_URL=
