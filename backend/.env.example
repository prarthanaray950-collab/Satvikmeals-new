# ── Keep these (existing) ────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://...
JWT_SECRET=your_jwt_secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
PORT=5000

# ── Telegram (keep — admin alerts still go here too) ─────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Resend (email) — ADD THESE ────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=SatvikMeals <hello@satvikmeals.in>
ADMIN_EMAIL=your_admin_email@gmail.com

# ── Baileys WhatsApp sender — ADD THESE ───────────────────────────────────────
# Path to folder where Baileys saves the WA session (relative to backend/)
WA_SESSION_PATH=./wa-session
# Your personal WhatsApp number (10 digits, no +91) — receives admin alerts
ADMIN_WA_NUMBER=9031447621

# ── Security — ADD THIS ────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API (CORS).
# Add your real domain(s) here. Do NOT use "*" in production.
ALLOWED_ORIGINS=https://satvikmeals.in,https://www.satvikmeals.in

# ── HTTPS / SSL ────────────────────────────────────────────────────────────────
# This app does not terminate TLS itself — it expects to run behind a reverse
# proxy or hosting platform that provides HTTPS (Render, Railway, Nginx + Let's
# Encrypt, Cloudflare, etc). No code changes are needed here; just make sure:
#   1. Your domain's DNS points to your host.
#   2. Your hosting platform's "Force HTTPS" / "Auto SSL" setting is ON.
#   3. ALLOWED_ORIGINS above uses https:// (not http://) for your real domain.
# If self-hosting on a VPS, use Certbot (Let's Encrypt) + Nginx as a reverse
# proxy in front of this Node process — do not expose Node directly on port 80/443.

# ── Remove these (Instamojo — no longer needed) ───────────────────────────────
# INSTAMOJO_API_KEY=
# INSTAMOJO_AUTH_TOKEN=
# INSTAMOJO_BASE_URL=
